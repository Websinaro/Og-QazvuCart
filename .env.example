# ==========================================
# QAZVUCART ENVIRONMENT CONFIGURATION
# ==========================================
# There are NO hardcoded fallback values for secrets anywhere in this
# codebase. Every variable below marked "REQUIRED" must be set or the
# server will throw on startup instead of silently using an insecure
# default.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# DATABASE (REQUIRED) - PostgreSQL is the only supported database.
# There is no SQLite / sql.js / PGlite / in-memory fallback.
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/marketplace_db"

# ==========================================
# AUTHENTICATION & TOKENS (ALL REQUIRED)
# Generate strong, unique secrets, e.g.: openssl rand -base64 48
# ==========================================
JWT_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# Reserved for signing/verifying payment provider webhooks & payment
# intents once a real payment gateway is integrated.
PAYMENT_SECRET="replace-with-a-long-random-string"

# ==========================================
# SEED / DEMO ACCOUNTS (OPTIONAL - used only by `npm run db:seed`)
# ==========================================
ADMIN_EMAIL="admin@qazvucart.com"
ADMIN_PASSWORD="AdminPassword@123"

DEMO_CUSTOMER_EMAIL="john@example.com"
DEMO_CUSTOMER_PASSWORD="Customer@123"

DEMO_SELLER_EMAIL="seller@primecommerce.com"
DEMO_SELLER_PASSWORD="Seller@123"
