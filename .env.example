# ==========================================
# QAZVUCART ENVIRONMENT CONFIGURATION
# ==========================================
# There are NO hardcoded fallback values for secrets anywhere in this
# codebase. Every variable below marked "REQUIRED" must be set or the
# server will throw on startup instead of silently using an insecure
# default.

# NEXT_PUBLIC_APP_URL: The public base URL where this app is hosted.
NEXT_PUBLIC_APP_URL="https://your-app.onrender.com"

# ==========================================
# DATABASE (REQUIRED) - PostgreSQL is the only supported database.
# There is no SQLite / sql.js / PGlite / in-memory fallback.
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/marketplace_db"

# ==========================================
# AUTHENTICATION & TOKENS (ALL REQUIRED)
# Generate strong, unique secrets, e.g.: openssl rand -base64 48
# ==========================================
JWT_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# ==========================================
# RAZORPAY (REQUIRED for online payments — COD works without these)
# Use your Razorpay TEST MODE keys (Dashboard -> Settings -> API Keys,
# with "Test Mode" toggled on). Never put the live secret key here for
# this deployment phase, and NEVER prefix any of these with NEXT_PUBLIC_ —
# the key secret and webhook secret must never reach the browser. Only
# the public key id is sent to the client, via the
# /api/payments/razorpay/create-order response.
# ==========================================
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-your-razorpay-test-key-secret"
# From Dashboard -> Settings -> Webhooks when you add the webhook URL
# https://YOUR_DOMAIN/api/payments/razorpay/webhook
# Subscribe the webhook to: payment.authorized, payment.captured, payment.failed,
# order.paid, refund.created, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET="replace-with-your-razorpay-webhook-secret"

# Shared secret for the scheduled payment maintenance job (recovers missed
# payments, retries refunds, reconciles with Razorpay, expires unpaid orders).
# Call POST /api/internal/payments/maintenance every 5-15 minutes with
#   Authorization: Bearer <CRON_SECRET>      (e.g. a Render Cron Job)
# Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-string"

# ==========================================
# CLOUDINARY (product image uploads via UNSIGNED upload preset)
# Both values below are public by design — an unsigned preset uploads
# straight from the browser, so there is no API secret to protect here.
# Create the preset at: Cloudinary Dashboard -> Settings -> Upload ->
# Upload presets -> Add upload preset -> Signing Mode: "Unsigned".
# Without these two vars, product image upload is disabled and only the
# manual "Image URL" field will work in the admin dashboard.
# ==========================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-preset"

# ==========================================
# FIREBASE (push notifications via Firebase Cloud Messaging)
# Without these, the in-app notification bell still works (it doesn't
# need Firebase at all) — only the push-to-device part is disabled, and
# NotificationService.sendBroadcast() logs a warning and continues.
#
# SERVER (private — service account, from Firebase Console -> Project
# Settings -> Service Accounts -> Generate new private key):
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# Paste the private_key value from the downloaded JSON exactly as-is,
# including the literal "\n" sequences — they're unescaped at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# CLIENT (public — from Firebase Console -> Project Settings -> General ->
# Your apps -> Web app -> SDK setup and configuration):
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef"
# Web push certificate (Firebase Console -> Project Settings -> Cloud
# Messaging -> Web configuration -> Web Push certificates -> Generate key pair):
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-vapid-key"

# ==========================================
# DEVELOPMENT-ONLY SEED ACCOUNTS
# Used ONLY by `npm run db:seed`, which itself refuses to run when
# NODE_ENV=production. Never set these in a production environment, and
# never reuse these values for a real account.
# ==========================================
SEED_CUSTOMER_EMAIL="dev-customer@example.test"
SEED_CUSTOMER_PASSWORD="replace-with-a-strong-local-only-password"

SEED_SELLER_EMAIL="dev-seller@example.test"
SEED_SELLER_PASSWORD="replace-with-a-strong-local-only-password"

# ==========================================
# ONE-TIME ADMIN BOOTSTRAP (CLI only)
# Used ONLY by `npm run admin:bootstrap`, which creates the first ADMIN
# and then permanently refuses to run again once any admin exists. The web
# app never reads these, and registering/logging in with them grants
# nothing. Set them, run the command once, then DELETE them from the
# environment. Password: 12+ chars with upper, lower and a digit.
# ==========================================
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Optional (defaults to the part of the email before the @):
ADMIN_BOOTSTRAP_USERNAME=

# ---------------------------------------------------------------------------
# MULTI-VENDOR: PAYOUT DATA ENCRYPTION
# Seller bank account numbers are encrypted at rest with AES-256-GCM. This must
# be 32 random bytes, base64-encoded. Generate one with:
#   openssl rand -base64 32
# There is intentionally NO fallback: saving payout details fails loudly if this
# is missing. Losing/rotating the key makes existing stored account numbers
# unreadable, so back it up like any other secret.
# ---------------------------------------------------------------------------
PAYOUT_ENCRYPTION_KEY=
