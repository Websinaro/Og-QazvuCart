# =====================================================================
# QazvuCart - ENVIRONMENT CONFIGURATION
# Copy to .env.local (dev) or set in your host's env UI (prod).
# NEVER commit real values. Anything prefixed NEXT_PUBLIC_ is visible
# in the browser - never put secrets in those.
# Legend: [REQUIRED] app/feature fails without it
#         [OPTIONAL] feature silently disables when unset
#         [CLI]      read only by an npm script, not by the web app
# =====================================================================

# ---------------------------------------------------------------------
# CORE
# ---------------------------------------------------------------------
NODE_ENV=development
# [OPTIONAL] Public base URL of the deployed app (used for webhook/docs).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------
# DATABASE [REQUIRED] - PostgreSQL only (Drizzle + pg)
# Hosted DBs (Render/Neon/Supabase) usually need ?sslmode=require
# ---------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/qazvucart"

# ---------------------------------------------------------------------
# AUTH [REQUIRED] - two DIFFERENT long random strings
# Generate each:  openssl rand -base64 48
# ---------------------------------------------------------------------
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# ---------------------------------------------------------------------
# PAYOUT ENCRYPTION [REQUIRED for seller payout details]
# Exactly 32 random bytes, base64:  openssl rand -base64 32
# Back this up. Losing/rotating it makes stored bank accounts unreadable.
# ---------------------------------------------------------------------
PAYOUT_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------
# RAZORPAY [REQUIRED for online payments; COD works without]
# Dashboard -> Settings -> API Keys (use TEST mode first).
# Webhook URL: https://YOUR_DOMAIN/api/payments/razorpay/webhook
# Events: payment.authorized, payment.captured, payment.failed,
#         order.paid, refund.created, refund.processed, refund.failed
# ---------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------
# CRON [REQUIRED for payment maintenance endpoint]
# POST /api/internal/payments/maintenance every 5-15 min with
#   Authorization: Bearer <CRON_SECRET>
# Generate:  openssl rand -base64 32
# ---------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------
# CLOUDINARY [OPTIONAL] - unsigned browser uploads for product images
# Settings -> Upload -> Upload presets -> Signing Mode: Unsigned
# Unset = only the manual "Image URL" field works.
# ---------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ---------------------------------------------------------------------
# FIREBASE PUSH [OPTIONAL] - in-app notification bell works without it
# SERVER: Firebase Console -> Project Settings -> Service Accounts
# Keep the literal \n sequences in the private key, wrapped in quotes.
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# CLIENT: Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Cloud Messaging -> Web Push certificates -> Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ---------------------------------------------------------------------
# SHIPROCKET SHIPPING [OPTIONAL] - unset = PIN checks pass, shipping manual
# Create an API user in Shiprocket: Settings -> API -> Add new API user
# (use a separate email from your main login).
# ---------------------------------------------------------------------
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# PIN on the other side of serviceability checks (default 110001)
SHIPROCKET_REFERENCE_PINCODE="110001"

# ---------------------------------------------------------------------
# EMAIL via Resend [OPTIONAL] - needs BOTH vars, else silent no-op
# EMAIL_FROM must be a sender on a domain verified in Resend.
# ---------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="QazvuCart <orders@yourdomain.com>"

# ---------------------------------------------------------------------
# SMS via Twilio [OPTIONAL] - needs ALL three, else silent no-op
# ---------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ---------------------------------------------------------------------
# [CLI] DEV SEED - `npm run db:seed` (refuses in production)
# ---------------------------------------------------------------------
SEED_CUSTOMER_EMAIL="dev-customer@example.test"
SEED_CUSTOMER_PASSWORD=""
SEED_SELLER_EMAIL="dev-seller@example.test"
SEED_SELLER_PASSWORD=""

# ---------------------------------------------------------------------
# [CLI] ONE-TIME ADMIN BOOTSTRAP - `npm run admin:bootstrap`
# Password: 12+ chars with upper, lower and a digit.
# Runs once; delete these afterwards.
# ---------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_USERNAME=""
